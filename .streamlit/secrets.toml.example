# PostHog analytics — free tier (1M events/month)
# 1. Create a project at https://posthog.com → copy your API key (phc_...)
# 2. Pick your region host (eu or us)
# 3. Copy this file to .streamlit/secrets.toml and fill in your key
posthog_api_key = "phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
posthog_host = "https://eu.i.posthog.com"

# Public-deploy switch: set this ONLY in the Streamlit Cloud dashboard secrets
# (Settings -> Secrets) of the public app. It hides private/in-development
# features (e.g. the Omni CD 360° profile). Local runs leave it unset and see
# everything -- no local config needed.
# public_deploy = true
