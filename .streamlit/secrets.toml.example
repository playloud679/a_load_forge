# PostHog analytics — free tier (1M events/month)
# 1. Create a project at https://posthog.com → copy your API key (phc_...)
# 2. Pick your region host (eu or us)
# 3. Copy this file to .streamlit/secrets.toml and fill in your key
posthog_api_key = "phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
posthog_host = "https://eu.posthog.com"
